{
  "name": "digital-avatar",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"pnpm --filter server dev\" \"pnpm --filter client dev\"",
    "build": "pnpm --filter client build",
    "start": "pnpm --filter server start",
    "test:scripts": "node --test scripts/validate-avatar-package.test.mjs scripts/verify-avatar-contract.mjs scripts/verify-offline-replay.mjs",
    "verify:contract": "node scripts/verify-avatar-contract.mjs --release",
    "verify:offline": "node --test scripts/verify-offline-replay.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}